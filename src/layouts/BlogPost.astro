---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	readingTime?: number;
	headings?: { depth: number; slug: string; text: string }[];
	relatedPosts?: CollectionEntry<'blog'>[];
};

const { title, description, pubDate, updatedDate, heroImage, tags, readingTime, headings, relatedPosts } = Astro.props;

const tocHeadings = (headings ?? []).filter((h) => h.depth === 2 || h.depth === 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<style>
			.hero-image { width: min(var(--content-width), calc(100% - 80px)); margin: 40px auto 0; border: 1px solid var(--border); }
			.hero-image img { width: 100%; height: clamp(180px, 25vw, 360px); object-fit: cover; }
			.article-content { width: min(760px, calc(100% - 80px)); margin-inline: auto; padding-top: 48px; display: flex; flex-direction: column; gap: 24px; }
			.meta { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; font-size: .75rem; color: var(--fg-muted); }
			.meta-date { color: var(--accent); }
			.last-updated { font-size: .7rem; }
			.article-title { font-size: clamp(1.6rem, 3.4vw, 2.65rem); line-height: 1.35; margin: 0; }
			.tags, .related-card-tags { display: flex; flex-wrap: wrap; gap: 8px 18px; }
			.tag, .related-tag { color: var(--accent); font-size: .7rem; }
			.tag::before, .related-tag::before { content: '#'; color: var(--fg-muted); }
			.article-divider { height: 1px; background: var(--border); }
			.toc { padding: 20px 24px; background: var(--surface-card); border-left: 2px solid var(--accent); }
			.toc-title { font-size: .75rem; letter-spacing: .08em; color: var(--accent); margin: 0 0 14px; }
			.toc-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
			.toc-list a { font-size: .85rem; text-decoration: none; }
			.toc-h3 { padding-left: 16px; }
			.related-title { font-size: 1rem; margin-bottom: 20px; }
			.related-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
			.related-card { display: flex; flex-direction: column; gap: 10px; border-top: 1px solid var(--border); padding: 18px 0; text-decoration: none; }
			.related-card:hover { border-color: var(--accent); }
			.related-card-date { font-size: .7rem; color: var(--fg-muted); }
			.related-card-title { font-size: 1rem; line-height: 1.5; margin: 0; }
			.back-link { font-size: .85rem; align-self: flex-start; }
			.prose :global(pre) { position: relative; }
			.prose :global(.copy-btn) { position: absolute; top: 8px; right: 8px; padding: 4px 12px; background: var(--surface-card); border: 1px solid var(--border); color: var(--accent); font-family: var(--font-code); font-size: .75rem; cursor: pointer; }
			.prose :global(.copy-btn:hover) { border-color: var(--accent); }
			@media (max-width: 640px) {
				.hero-image { width: calc(100% - 40px); margin-top: 24px; }
				.article-content { width: calc(100% - 40px); padding-top: 28px; gap: 20px; }
				.related-grid { grid-template-columns: 1fr; gap: 0; }
				.toc { padding: 16px; }
			}
		</style>
	</head>

	<body>
		<Header />
		<main id="main-content">
			<article>
				{heroImage && (
					<div class="hero-image">
						<Image width={1440} height={400} src={heroImage} alt="" />
					</div>
				)}
				<div class="article-content">
					<div class="meta">
						<span class="meta-date"><FormattedDate date={pubDate} /></span>
						{readingTime && (
							<>
								<span class="meta-dot">&middot;</span>
								<span class="meta-read">{readingTime} min read</span>
							</>
						)}
						{updatedDate && (
							<span class="last-updated">
								Updated <FormattedDate date={updatedDate} />
							</span>
						)}
					</div>
					<h1 class="article-title">{title}</h1>
					{tags && tags.length > 0 && (
						<div class="tags">
							{tags.map((tag: string) => (
								<span class="tag">{tag}</span>
							))}
						</div>
					)}
					<div class="article-divider"></div>
					{tocHeadings.length > 2 && (
						<nav class="toc" aria-label="Table of contents">
							<p class="toc-title">TABLE OF CONTENTS</p>
							<ul class="toc-list">
								{tocHeadings.map((h) => (
									<li class={h.depth === 3 ? 'toc-h3' : ''}>
										<a href={`#${h.slug}`}>{h.text}</a>
									</li>
								))}
							</ul>
						</nav>
					)}
					<div class="prose">
						<slot />
					</div>
					{relatedPosts && relatedPosts.length > 0 && (
						<>
							<div class="article-divider"></div>
							<section class="related-section">
								<h2 class="related-title">Related Posts</h2>
								<div class="related-grid">
									{relatedPosts.map((rp: CollectionEntry<'blog'>) => (
										<a href={`/blog/${rp.id}/`} class="related-card">
											<span class="related-card-date"><FormattedDate date={rp.data.pubDate} /></span>
											<h3 class="related-card-title">{rp.data.title}</h3>
											<div class="related-card-tags">
												{(rp.data.tags ?? []).map((t: string) => (
													<span class="related-tag">{t}</span>
												))}
											</div>
										</a>
									))}
								</div>
							</section>
						</>
					)}
					<div class="article-divider"></div>
					<a href="/blog" class="back-link">&larr; Back to all posts</a>
				</div>
			</article>
		</main>
		<Footer />

		<script>
			document.querySelectorAll('pre').forEach((pre) => {
				const btn = document.createElement('button');
				btn.className = 'copy-btn';
				btn.textContent = 'Copy';
				btn.type = 'button';
				btn.setAttribute('aria-label', 'Copy code to clipboard');
				btn.setAttribute('aria-live', 'polite');
				btn.addEventListener('click', async () => {
					const code = pre.querySelector('code');
					if (code) {
						try {
							await navigator.clipboard.writeText(code.textContent ?? '');
						} catch {
							btn.textContent = 'Copy failed';
							setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
							return;
						}
						btn.textContent = 'Copied!';
						btn.classList.add('copied');
						setTimeout(() => {
							btn.textContent = 'Copy';
							btn.classList.remove('copied');
						}, 2000);
					}
				});
				pre.style.position = 'relative';
				pre.appendChild(btn);
			});
		</script>
	</body>
</html>
