---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/PostList.astro';
import { SITE_TITLE } from '../../consts';
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<!doctype html>
<html lang="en">
	<head><BaseHead title={`Blog | ${SITE_TITLE}`} description="Thoughts on engineering culture, team dynamics, and the chaos of building software." /></head>
	<body>
		<Header />
		<main id="main-content" class="container">
			<div class="page-heading">
				<p class="eyebrow">The blog / {String(posts.length).padStart(2, '0')} entries</p>
				<h1 class="pixel-heading">All writing</h1>
				<p>Thoughts on engineering culture, team dynamics, and the chaos of building software.</p>
			</div>
			<section aria-label="All blog posts">
				<h2 class="sr-only">Posts, newest first</h2>
				<PostList posts={posts} detailed />
			</section>
		</main>
		<Footer />
	</body>
</html>
<style>
	h1 { font-size: clamp(1.4rem, 3vw, 2.5rem); }
	section { border-top: 1px solid var(--border); }
</style>
