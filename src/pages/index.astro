---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PixelMachine from '../components/PixelMachine.astro';
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---
<!doctype html>
<html lang="en">
	<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main id="main-content" class="container">
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow">Software / People / Things that break</p>
					<h1 id="hero-title"><span class="title-small">The</span> <span>Chaotic</span> <span>Engineer</span></h1>
					<p class="hero-description">Exploring the beautiful chaos of software engineering,<br class="desktop-break" /> one line of code at a time.</p>
					<a href="/about" class="text-link">More about me <span aria-hidden="true">↗</span></a>
				</div>
				<PixelMachine />
			</section>
			<section aria-labelledby="recent-title">
				<div class="section-heading"><h2 id="recent-title" class="eyebrow">Recent writing</h2><span>{String(posts.length).padStart(2, '0')} entries</span></div>
				<PostList posts={posts} />
				<a href="/blog" class="all-posts text-link">All writing <span aria-hidden="true">→</span></a>
			</section>
		</main>
		<Footer />
	</body>
</html>
<style>
	.hero { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); align-items: center; gap: 20px; padding-block: 54px 62px; }
	.hero-copy { min-width: 0; }
	.hero .eyebrow { margin-bottom: 24px; font-size: .8rem; letter-spacing: .075em; }
	h1 { font-family: var(--font-pixel); font-weight: 400; text-transform: uppercase; color: var(--accent); font-size: clamp(2rem, 4.85vw, 4.25rem); line-height: 1.42; letter-spacing: -.055em; margin: 0 0 20px; }
	h1 span { display: block; }
	h1 .title-small { font-size: .53em; line-height: 1.6; }
	.hero-description { font-size: clamp(.95rem, 1.35vw, 1.15rem); margin-bottom: 18px; }
	.section-heading { border-top: 1px solid var(--fg-muted); padding-top: 18px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
	.section-heading h2 { margin: 0; font-weight: 400; }
	.section-heading > span { font-size: .75rem; color: var(--fg-muted); }
	.all-posts { display: inline-block; margin-top: 20px; font-size: .85rem; }
	@media (min-width: 1400px) { .hero { padding-block: 62px 72px; } }
	@media (max-width: 900px) {
		.hero { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); }
		h1 { font-size: 4.6vw; }
		.hero .eyebrow { font-size: .65rem; }
		.desktop-break { display: none; }
	}
	@media (max-width: 640px) {
		.hero { grid-template-columns: 1fr; gap: 12px; padding-block: 36px 30px; }
		h1 { font-size: clamp(1.8rem, 7.8vw, 3rem); margin-bottom: 22px; }
		.hero .eyebrow { font-size: .6rem; letter-spacing: .02em; margin-bottom: 20px; }
		.hero-description { max-width: 36ch; }
	}
</style>
