---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import AboutImage from '../assets/about-profile.png';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description="Software engineer navigating the chaos" />
		<style>
			.about-header { padding-block: 64px 40px; max-width: 850px; }
			.eyebrow { color: var(--accent); }
			.page-title { font-family: var(--font-pixel); font-size: clamp(1.2rem, 2.7vw, 2.25rem); font-weight: 400; line-height: 1.6; color: var(--accent); margin: 20px 0 0; }
			.divider { height: 1px; background: var(--border); }
			.bio-section { display: grid; grid-template-columns: minmax(200px, 300px) minmax(0, 1fr); align-items: center; gap: 64px; padding-block: 48px; }
			.bio-image { border: 1px solid var(--border); padding: 8px; }
			.bio-image img { width: 100%; height: auto; }
			.bio-title { font-size: 1.75rem; }
			.bio-text { font-family: var(--font-sans); font-size: 1.125rem; line-height: 1.85; max-width: 65ch; }
			.bio-text:last-child { margin-bottom: 0; }
			.tech-section { padding-block: 36px; }
			.tech-title { font-size: .8rem; text-transform: uppercase; letter-spacing: .1em; margin-bottom: 24px; }
			.tech-grid { display: flex; flex-wrap: wrap; gap: 12px 24px; }
			.tech-badge { color: var(--accent); font-size: .95rem; }
			.tech-badge::before { content: '+ '; color: var(--fg-muted); }
			@media (max-width: 800px) {
				.bio-section { gap: 28px; grid-template-columns: minmax(160px, 220px) minmax(0, 1fr); }
			}
			@media (max-width: 640px) {
				.about-header { padding-block: 40px 28px; }
				.bio-section { grid-template-columns: 1fr; padding-block: 32px; }
				.bio-image { max-width: 240px; }
				.bio-text { font-size: 1.0625rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" class="container">
			<section class="about-header">
				<span class="eyebrow">ABOUT</span>
				<h1 class="page-title">The Engineer Behind the Chaos</h1>
			</section>

			<div class="divider"></div>

			<section class="bio-section">
				<div class="bio-image">
					<Image src={AboutImage} alt="Illustration of an engineer in his workshop" width={350} height={400} />
				</div>
				<div class="bio-content">
					<h2 class="bio-title">Hi, I'm Lukasz</h2>
					<p class="bio-text">
						I've been a software engineer since 2017, working primarily with .NET, Angular, React, and Blazor.
						I'm passionate about clean code, solid architecture patterns, and the open-source ecosystem.
					</p>
					<p class="bio-text">
						This blog is my space to share thoughts that go beyond just code. It's about the people, the processes, and
						the patterns that make great engineering teams. I believe that culture eats strategy for breakfast, and that
						the best software is built by teams that trust each other.
					</p>
				</div>
			</section>

			<div class="divider"></div>

			<section class="tech-section">
				<h2 class="tech-title">Tech I Work With</h2>
				<div class="tech-grid">
					<span class="tech-badge">.NET</span>
					<span class="tech-badge">Angular</span>
					<span class="tech-badge">React</span>
					<span class="tech-badge">Blazor</span>
					<span class="tech-badge">Astro</span>
				</div>
			</section>

			<div class="divider"></div>
		</main>
		<Footer />
	</body>
</html>
