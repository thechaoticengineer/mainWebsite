---
import CableDivider from './CableDivider.astro';
const today = new Date();
---
<footer class="container">
	<CableDivider reverse />
	<div class="footer-content">
		<span class="copyright">&copy; {today.getFullYear()} The Chaotic Engineer</span>
		<nav aria-label="Footer navigation">
			<a href="/rss.xml">RSS <span aria-hidden="true">↗</span></a>
			<a href="https://github.com/thechaoticengineer" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
			<a href="/sitemap-index.xml">Sitemap</a>
		</nav>
	</div>
</footer>
<style>
	footer { margin-top: 72px; padding-bottom: 32px; }
	.footer-content { display: flex; justify-content: space-between; gap: 24px; padding-top: 8px; font-size: .8rem; }
	nav { display: flex; gap: 24px; flex-wrap: wrap; }
	.copyright { color: var(--fg-muted); }
	@media (max-width: 640px) {
		footer { margin-top: 48px; }
		.footer-content { flex-direction: column; gap: 14px; }
		nav a { padding-block: 6px; }
	}
</style>
