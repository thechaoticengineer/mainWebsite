---
import { Image } from 'astro:assets';
import Machine from '../assets/pixel-machine.png';
---
<div class="machine" aria-hidden="true">
	<div class="motion-art machine-body">
		<Image src={Machine} alt="" width={520} widths={[320, 520, 780]} sizes="(max-width: 640px) 280px, (max-width: 900px) 340px, 460px" loading="eager" />
		<span class="screen"><span class="motion-art screen-sweep"></span></span>
		<span class="motion-art beacon"></span>
		<span class="motion-art signal signal-one"></span>
		<span class="motion-art signal signal-two"></span>
		<span class="motion-art signal signal-three"></span>
	</div>
	<svg class="satellite satellite-chip" viewBox="0 0 40 40" fill="none" shape-rendering="crispEdges">
		<g class="motion-art chip-float"><path d="M10 6h20v4h4v20h-4v4H10v-4H6V10h4z" fill="var(--surface)" stroke="var(--fg)" stroke-width="2"/><path d="M16 0v6m8-6v6M16 34v6m8-6v6M0 16h6m-6 8h6m28-8h6m-6 8h6" stroke="var(--accent)" stroke-width="2"/><path d="M15 15h10v10H15z" stroke="var(--accent)" stroke-width="2"/><path d="M19 18v4m3-4v4" stroke="var(--accent)" stroke-width="2"/></g>
	</svg>
	<svg class="satellite satellite-meter" viewBox="0 0 32 40" fill="none" shape-rendering="crispEdges">
		<path d="M6 2h20v4h4v30h-4v2H6v-2H2V6h4z" fill="var(--surface)" stroke="var(--fg)" stroke-width="2"/>
		<path class="motion-art meter-fill" d="M8 27h16v5H8zM8 19h16v5H8zM8 11h16v5H8z" fill="#d5a454"/>
	</svg>
	<span class="signal-trail"><span class="motion-art trail-packet"></span></span>
</div>
<style>
	.machine { position: relative; width: 100%; max-width: 480px; justify-self: end; }
	.machine-body { position: relative; animation: machine-idle 5s steps(4, end) infinite; }
	.machine img { width: 100%; image-rendering: pixelated; }
	.screen { position: absolute; left: 35.5%; top: 30%; width: 21.5%; height: 15.5%; overflow: hidden; clip-path: polygon(6% 0, 94% 0, 100% 8%, 100% 92%, 94% 100%, 6% 100%, 0 92%, 0 8%); }
	.screen-sweep { position: absolute; top: -2px; display: block; width: 100%; height: 2px; background: var(--accent); opacity: .28; animation: screen-scan 4s steps(24, end) infinite; }
	.beacon { position: absolute; left: 72%; top: 43%; width: 4%; height: 5%; background: #f5c868; opacity: .1; clip-path: polygon(25% 0, 75% 0, 100% 25%, 100% 100%, 0 100%, 0 25%); animation: beacon-light 4s steps(2, end) infinite; }
	.signal { position: absolute; width: 5px; height: 5px; background: var(--accent); animation: signal 3s steps(1, end) infinite; }
	.signal-one { top: 44%; left: 24%; }
	.signal-two { top: 64%; right: 12%; animation-delay: -1s; }
	.signal-three { top: 24%; left: 29%; animation-delay: -2s; }
	.satellite { position: absolute; width: 38px; height: 42px; }
	.satellite-chip { top: 16%; left: 2%; overflow: visible; }
	.chip-float { animation: chip-idle 6s steps(4, end) infinite; }
	.satellite-meter { top: 55%; left: 0; width: 28px; }
	.meter-fill { animation: meter 3s steps(1, end) infinite; }
	.signal-trail { position: absolute; left: 5%; top: 29%; height: 21%; border-left: 2px dashed var(--border); }
	.trail-packet { position: absolute; left: -3px; width: 4px; height: 6px; background: var(--accent); animation: trail 3s steps(16, end) infinite; }
	@keyframes machine-idle { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
	@keyframes chip-idle { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(6px); } }
	@keyframes screen-scan { from { top: -2px; } to { top: 100%; } }
	@keyframes beacon-light { 0%, 65%, 100% { opacity: .1; } 75%, 85% { opacity: .75; } }
	@keyframes signal { 0%, 60%, 100% { opacity: .2; } 65%, 80% { opacity: 1; } }
	@keyframes meter { 0%, 100% { opacity: .3; } 50% { opacity: 1; } }
	@keyframes trail { from { top: 0; } to { top: 100%; } }
	@media (max-width: 900px) { .machine { max-width: 360px; } }
	@media (max-width: 640px) { .machine { width: min(280px, 100%); justify-self: center; } }
	@media (prefers-reduced-motion: reduce) { .screen-sweep, .beacon, .trail-packet { display: none; } }
</style>
